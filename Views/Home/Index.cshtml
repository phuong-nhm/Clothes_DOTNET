@{
    ViewData["Title"] = "Trang chủ";
    Layout = "_Layout";
}
@using CLothes_DOTNET.Models
@model IEnumerable<Products>

<!-- Hero Banner Carousel -->
<div id="heroBanner" class="carousel slide mb-5" data-bs-ride="carousel" data-bs-interval="4000">
    <div class="carousel-inner rounded-2 overflow-hidden">
        <div class="carousel-item active">
            <img src="~/asset/bn1.png" class="d-block w-100" alt="Banner 1" style="height: 420px; object-fit: cover;">
        </div>
        <div class="carousel-item">
            <img src="~/asset/bn2.png" class="d-block w-100" alt="Banner 2" style="height: 420px; object-fit: cover;">
        </div>
        <div class="carousel-item">
            <img src="~/asset/bn3.png" class="d-block w-100" alt="Banner 3" style="height: 420px; object-fit: cover;">
        </div>
        <div class="carousel-item">
            <img src="~/asset/bn4.png" class="d-block w-100" alt="Banner 4" style="height: 420px; object-fit: cover;">
        </div>
    </div>
    <button class="carousel-control-prev" type="button" data-bs-target="#heroBanner" data-bs-slide="prev">
        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
    </button>
    <button class="carousel-control-next" type="button" data-bs-target="#heroBanner" data-bs-slide="next">
        <span class="carousel-control-next-icon" aria-hidden="true"></span>
    </button>
</div>

<!-- Section Title -->
<div class="text-center mb-5">
    <h2 class="fw-bold fs-1 text-dark mb-2">Hàng Hot Tháng Này</h2>
    <p class="text-muted fs-6">Những sản phẩm được yêu thích nhất hiện nay</p>
</div>

<!-- Product Grid -->
<div id="show_data" class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4 mb-5">
    <!-- Dữ liệu từ JS sẽ load vào đây -->
</div>

<!-- Pagination -->
<div id="pagination" class="d-flex justify-content-center my-4"></div>

@section Scripts {
    <script src="~/js/Getproduct.js" asp-append-version="true"></script>
    <script>
        $(document).ready(function() {
            // Load products for homepage
            LoadData("", "", null, "", "", "", 1, 12);
        });
    </script>
}