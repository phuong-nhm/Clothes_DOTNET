@{
    ViewData["Title"] = "Trang chủ";
    Layout = "_Layout";
}
@using CLothes_DOTNET.Models
@model IEnumerable<Products>

<!-- Banner Slider (Bootstrap Carousel) -->
<div id="mainBanner" class="carousel slide my-3 shadow-sm rounded overflow-hidden" data-bs-ride="carousel" data-bs-interval="3500">
    <!-- Carousel Indicators (Nút tròn chuyển slide) -->
    <div class="carousel-indicators">
        <button type="button" data-bs-target="#mainBanner" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
        <button type="button" data-bs-target="#mainBanner" data-bs-slide-to="1" aria-label="Slide 2"></button>
        <button type="button" data-bs-target="#mainBanner" data-bs-slide-to="2" aria-label="Slide 3"></button>
        <button type="button" data-bs-target="#mainBanner" data-bs-slide-to="3" aria-label="Slide 4"></button>
    </div>

    <!-- Carousel Inner (Danh sách ảnh banner) -->
    <div class="carousel-inner" style="max-height: 500px;">
        <div class="carousel-item active">
            <img src="~/asset/bn1.png" class="d-block w-100 object-fit-cover" alt="Banner 1" style="height: 500px;">
        </div>
        <div class="carousel-item">
            <img src="~/asset/bn2.png" class="d-block w-100 object-fit-cover" alt="Banner 2" style="height: 500px;">
        </div>
        <div class="carousel-item">
            <img src="~/asset/bn3.png" class="d-block w-100 object-fit-cover" alt="Banner 3" style="height: 500px;">
        </div>
        <div class="carousel-item">
            <img src="~/asset/bn4.png" class="d-block w-100 object-fit-cover" alt="Banner 4" style="height: 500px;">
        </div>
    </div>

    <!-- Carousel Controls (Nút Prev / Next) -->
    <button class="carousel-control-prev" type="button" data-bs-target="#mainBanner" data-bs-slide="prev">
        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Trước</span>
    </button>
    <button class="carousel-control-next" type="button" data-bs-target="#mainBanner" data-bs-slide="next">
        <span class="carousel-control-next-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Sau</span>
    </button>
</div>

<!-- Section Tiêu đề -->
<div class="container my-5 text-center">
    <h2 class="fw-bold text-uppercase tracking-wide position-relative d-inline-block pb-2">
        Hàng Hot Tháng 11
        <span class="position-absolute bottom-0 start-50 translate-middle-x bg-danger rounded" style="height: 3px; width: 60px;"></span>
    </h2>
</div>

<!-- Container hiển thị sản phẩm bằng AJAX (Dùng Grid Bootstrap g-4) -->
<div id="show_data" class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
    <!-- Sản phẩm sẽ được render từ JS Getproduct.js vào đây -->
</div>

@section Scripts {
    <script src="~/js/Getproduct.js"></script>
    <script src="~/js/Index.js" asp-append-version="true"></script>
}