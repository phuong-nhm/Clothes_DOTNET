@{
    ViewData["Title"] = "Tất cả sản phẩm";
    Layout = "_Layout";
}
@using Clothes_DOTNET.Models
@model IEnumerable<Product>

<!-- Thanh Bộ Lọc (Filter Bar) -->
<div class="bg-light p-3 rounded-3 shadow-sm my-4 d-flex align-items-center justify-content-between flex-wrap gap-2">
    <form class="d-flex align-items-center flex-wrap gap-2 w-100">
        <span class="fw-semibold text-secondary me-2">Sắp xếp theo:</span>

        <!-- Các nút lọc nhanh -->
        <div class="d-flex flex-wrap gap-2 me-auto filter-buttons">
            <a href="#" class="btn btn-secondary btn-sm rounded-pill px-3 fw-medium filter-btn active">Phổ Biến</a>
            <a href="#" class="btn btn-outline-secondary btn-sm rounded-pill px-3 fw-medium filter-btn">Mới nhất</a>
            <a href="#" class="btn btn-outline-secondary btn-sm rounded-pill px-3 fw-medium filter-btn">Bán chạy</a>
        </div>

        <!-- Dropdown Sắp xếp giá -->
        <div class="d-flex align-items-center mt-2 mt-sm-0">
            <select id="category" name="category" class="form-select form-select-sm border-secondary-subtle rounded-3" style="min-width: 160px;">
                <option value="">Giá (Mặc định)</option>
                <option value="price_asc">Giá tăng dần</option>
                <option value="price_desc">Giá giảm dần</option>
            </select>
        </div>
    </form>
</div>

<!-- Container Danh sách Sản phẩm -->
<div id="show_data" class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4 mb-4">
    <!-- Dữ liệu từ JS Getproduct.js sẽ đổ vào đây -->
</div>

<!-- Container Phân Trang -->
<div id="pagination" class="d-flex justify-content-center my-4">
    <!-- Dữ liệu phân trang từ JS sẽ đổ vào đây -->
</div>

@section Scripts {
    <script src="~/js/Getproduct.js" asp-append-version="true"></script>
    <script src="~/js/Index.js" asp-append-version="true"></script>

    <script>
        // Xử lý đổi màu Active cho các nút lọc
        $('.filter-btn').on('click', function (e) {
            e.preventDefault();

            // Bỏ active tất cả các nút
            $('.filter-btn')
                .removeClass('btn-secondary active')
                .addClass('btn-outline-secondary');

            // Set active cho nút vừa click
            $(this)
                .removeClass('btn-outline-secondary')
                .addClass('btn-secondary active');
        });
    </script>
}