@{
    ViewData["Title"] = "Tất cả sản phẩm";
    Layout = "_Layout";
}
@using Clothes_DOTNET.Models
@model IEnumerable<Product>

<!-- Page Title -->
<div class="mb-5">
    <h1 class="fw-bold fs-2 text-dark mb-2">Tất cả Sản phẩm</h1>
    <p class="text-muted">Khám phá bộ sưu tập đầy đủ của chúng tôi</p>
</div>

<!-- Filter & Sort Bar -->
<div class="bg-light rounded-3 p-4 mb-4">
    <div class="row align-items-center g-3">
        <div class="col-auto">
            <span class="text-muted fw-semibold">Sắp xếp:</span>
        </div>
        <div class="col-auto d-flex flex-wrap gap-2">
            <a href="#" class="btn btn-dark btn-sm rounded-pill px-3 fw-medium filter-btn active">Phổ Biến</a>
            <a href="#" class="btn btn-outline-dark btn-sm rounded-pill px-3 fw-medium filter-btn">Mới nhất</a>
            <a href="#" class="btn btn-outline-dark btn-sm rounded-pill px-3 fw-medium filter-btn">Bán chạy</a>
        </div>
        <div class="col-auto ms-auto">
            <select id="sortBy" class="form-select form-select-sm border-secondary-subtle rounded-3" style="min-width: 160px;">
                <option value="">Giá (Mặc định)</option>
                <option value="price_asc">Giá tăng dần</option>
                <option value="price_desc">Giá giảm dần</option>
            </select>
        </div>
    </div>
</div>

<!-- Product Grid -->
<div id="show_data" class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4 mb-5">
    <!-- Dữ liệu từ JS sẽ load vào đây -->
</div>

<!-- Pagination -->
<div id="pagination" class="d-flex justify-content-center my-5"></div>

@section Scripts {
    <script src="~/js/Getproduct.js" asp-append-version="true"></script>
    <script>
        $('.filter-btn').on('click', function (e) {
            e.preventDefault();
            $('.filter-btn').removeClass('btn-dark active').addClass('btn-outline-dark');
            $(this).removeClass('btn-outline-dark').addClass('btn-dark active');
        });
    </script>
}