@{
    ViewData["Title"] = "Đồ Nữ";
    Layout = "_Layout";
}
@using CLothes_DOTNET.Models
@model IEnumerable<Products>

<!-- Breadcrumb -->
<nav aria-label="breadcrumb" class="mb-4">
    <ol class="breadcrumb bg-transparent p-0">
        <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")" class="text-dark text-decoration-none">Trang chủ</a></li>
        <li class="breadcrumb-item active text-muted" aria-current="page">Nữ</li>
    </ol>
</nav>

<!-- Page Title -->
<div class="mb-5">
    <h1 class="fw-bold fs-2 text-dark mb-2">Bộ Sưu Tập Nữ</h1>
    <p class="text-muted">Khám phá những trang phục nữ xinh đẹp và thanh lịch</p>
</div>

<!-- Layout: Sidebar Filters & Products -->
<div class="row g-4 mb-5">
    <!-- Sidebar Filters -->
    <div class="col-lg-3">
        <div class="bg-light rounded-3 p-4 position-sticky" style="top: 80px;">
            <h5 class="fw-bold text-dark mb-4">Bộ Lọc</h5>
            
            <form>
                <!-- Price Filter -->
                <div class="mb-4">
                    <label class="form-label fw-semibold text-dark mb-2">Khoảng Giá</label>
                    <input type="range" class="form-range" id="priceFilter" min="0" max="1000000" step="10000" value="1000000">
                    <small class="text-muted d-block mt-1">Tối đa: <span id="priceValue">1.000.000</span>đ</small>
                </div>

                <!-- Category Filter -->
                <div class="mb-4">
                    <label class="form-label fw-semibold text-dark mb-2">Danh Mục</label>
                    <select class="form-select form-select-sm border-secondary-subtle rounded-2" id="categoryFilter">
                        <option value="">Tất cả</option>
                        <option value="clothing">Trang phục</option>
                        <option value="accessories">Phụ kiện</option>
                        <option value="shoes">Giày dép</option>
                    </select>
                </div>

                <!-- Apply Button -->
                <button type="button" class="btn btn-dark w-100 rounded-3" onclick="applyFilters()">Áp Dụng</button>
            </form>
        </div>
    </div>

    <!-- Products Grid -->
    <div class="col-lg-9">
        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-2 row-cols-lg-3 g-4">
            @if (Model != null && Model.Any())
            {
                @foreach (var product in Model)
                {
                    <div class="col">
                        <div class="card h-100 border-0 shadow-sm rounded-3 overflow-hidden position-relative">
                            <a href="@Url.Action("Product", "Sale", new { id = product.Id })" class="text-decoration-none">
                                <div class="overflow-hidden" style="height: 280px;">
                                    <img src="@Url.Content(product.ImageUrl)" alt="@product.Name" class="w-100 h-100 object-fit-cover" style="transition: transform .4s ease;">
                                </div>
                            </a>
                            <div class="card-body d-flex flex-column p-3">
                                <h6 class="card-title fw-semibold text-dark text-truncate mb-2">
                                    <a href="@Url.Action("Product", "Sale", new { id = product.Id })" class="text-dark text-decoration-none">@product.Name</a>
                                </h6>
                                <p class="text-muted small mb-3 flex-grow-1">@product.Description</p>
                                <div class="mb-3">
                                    <span class="fw-bold text-dark fs-6">@product.Price.ToString("N0")đ</span>
                                </div>
                                <button class="btn btn-dark btn-sm w-100 rounded-pill fw-medium" onclick="window.location='@Url.Action("Order", "User", new { id = product.Id })'">Mua ngay</button>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12 text-center py-5">
                    <p class="text-muted fs-6">Không có sản phẩm nào</p>
                </div>
            }
        </div>

        <!-- Pagination -->
        @if (ViewBag.TotalPages > 1)
        {
            <nav aria-label="Page navigation" class="d-flex justify-content-center mt-5">
                <ul class="pagination gap-2">
                    @if (ViewBag.PageNumber > 1)
                    {
                        <li class="page-item">
                            <a class="page-link rounded-3 border-0 bg-light text-dark fw-medium" href="@Url.Action("Womenpage", new { page = ViewBag.PageNumber - 1 })">← Trước</a>
                        </li>
                    }

                    @for (int i = 1; i <= ViewBag.TotalPages; i++)
                    {
                        if (i == ViewBag.PageNumber)
                        {
                            <li class="page-item">
                                <span class="page-link rounded-3 border-0 bg-dark text-white fw-medium">@i</span>
                            </li>
                        }
                        else
                        {
                            <li class="page-item">
                                <a class="page-link rounded-3 border-0 bg-light text-dark fw-medium" href="@Url.Action("Womenpage", new { page = i })">@i</a>
                            </li>
                        }
                    }

                    @if (ViewBag.PageNumber < ViewBag.TotalPages)
                    {
                        <li class="page-item">
                            <a class="page-link rounded-3 border-0 bg-light text-dark fw-medium" href="@Url.Action("Womenpage", new { page = ViewBag.PageNumber + 1 })">Sau →</a>
                        </li>
                    }
                </ul>
            </nav>
        }
    </div>
</div>

<script>
    document.getElementById('priceFilter').addEventListener('input', function(e) {
        const value = parseInt(e.target.value);
        document.getElementById('priceValue').textContent = value.toLocaleString('vi-VN');
    });

    function applyFilters() {
        const price = document.getElementById('priceFilter').value;
        const category = document.getElementById('categoryFilter').value;
        console.log('Price:', price, 'Category:', category);
    }

    // Hover zoom effect
    document.querySelectorAll('.overflow-hidden img').forEach(img => {
        const parent = img.parentElement;
        parent.addEventListener('mouseenter', function() {
            img.style.transform = 'scale(1.08)';
        });
        parent.addEventListener('mouseleave', function() {
            img.style.transform = 'scale(1)';
        });
    });
</script>
