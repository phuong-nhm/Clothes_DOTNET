@{
    ViewData["Title"] = "Chi Tiết Sản Phẩm";
    var sizes = ViewData["Sizes"] as List<Size> ?? new List<Size>();
    var colors = ViewData["Colors"] as List<Color> ?? new List<Color>();
    var ProductColorVarients = ViewData["ProductColorVarients"] as List<ProductVariant> ?? new List<ProductVariant>();
    var ProductSizeVarients = ViewData["ProductSizeVarients"] as List<ProductVariant> ?? new List<ProductVariant>();
    var boolcolor = true;
    var boolsize = true;
    Layout = "_Layout";
}
@using Clothes_DOTNET.Models
@model Product

<!-- Breadcrumb -->
<nav aria-label="breadcrumb" class="mb-4">
    <ol class="breadcrumb bg-transparent p-0">
        <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")" class="text-dark text-decoration-none">Trang chủ</a></li>
        <li class="breadcrumb-item active text-muted" aria-current="page">Chi tiết sản phẩm</li>
    </ol>
</nav>

<!-- Product Detail Section -->
<div class="row g-5 mb-5">
    <!-- Product Image -->
    <div class="col-lg-5">
        <div class="rounded-3 overflow-hidden bg-light">
            @if (Model.image != null)
            {
                var imageSrc = $"/UserImage/images/{Model.image}";
                <img src="@imageSrc" alt="@Model.name" class="w-100" style="height: 500px; object-fit: cover;">
            }
            else
            {
                <div class="w-100 bg-secondary d-flex align-items-center justify-content-center" style="height: 500px;">
                    <span class="text-light">No image available</span>
                </div>
            }
        </div>
    </div>

    <!-- Product Info -->
    <div class="col-lg-7">
        <form asp-controller="Sale" asp-action="AddToCart" method="post">
            <input type="hidden" id="productId" name="productId" value="@Model.ID">

            <!-- Title & ID -->
            <h1 class="fw-bold fs-2 text-dark mb-2">@Model.name</h1>
            <p class="text-muted small mb-3">Mã sản phẩm: <span class="text-dark fw-semibold">@Model.ID</span></p>

            <!-- Price -->
            <div class="mb-4">
                <span class="fw-bold fs-4 text-dark" id="Price">@Model.sellprice.ToString("N0")đ</span>
                <input type="hidden" id="price" name="price" value="@Model.sellprice">
            </div>

            <!-- Divider -->
            <hr class="my-4">

            <!-- Colors -->
            <div class="mb-4">
                <label class="fw-semibold text-dark d-block mb-3">Màu Sắc</label>
                <div class="d-flex flex-wrap gap-2">
                    @foreach (var color in colors)
                    {
                        boolcolor = ProductColorVarients.Any(pro => pro.ColorID == color.ColorID);
                        if (boolcolor)
                        {
                            <input type="radio" class="btn-check" name="color-outlined" id="color_@color.ColorID-outlined" onchange="updateQuantityDisplay()" autocomplete="off" value="@color.ColorID">
                            <label class="btn btn-outline-dark btn-sm fw-medium rounded-pill px-3" for="color_@color.ColorID-outlined">@color.ColorName</label>
                        }
                    }
                </div>
                <input type="hidden" id="selectedColorId" name="selectedColorId" value="">
                <input type="hidden" id="selectedColorName" name="selectedColorName" value="">
            </div>

            <!-- Sizes -->
            <div class="mb-4">
                <label class="fw-semibold text-dark d-block mb-3">Kích Thước</label>
                <div class="d-flex flex-wrap gap-2">
                    @foreach (var size in sizes)
                    {
                        boolsize = ProductSizeVarients.Any(pro => pro.SizeID == size.SizeID);
                        <input type="radio" class="btn-check" name="size-outlined" id="size_@size.SizeID-outlined" onchange="updateQuantityDisplay()" autocomplete="off" value="@size.SizeID" @(boolsize ? "" : "disabled")>
                        <label class="btn btn-outline-dark btn-sm fw-medium rounded-pill px-3 @(boolsize ? "" : "disabled")" for="size_@size.SizeID-outlined">@size.SizeName</label>
                    }
                </div>
                <input type="hidden" id="selectedSizeId" name="selectedSizeId" value="">
                <input type="hidden" id="selectedSizeName" name="selectedSizeName" value="">
            </div>

            <!-- Quantity -->
            <div class="mb-4">
                <label class="fw-semibold text-dark d-block mb-2">Số Lượng</label>
                <div class="input-group" style="width: 140px;">
                    <button class="btn btn-outline-dark" type="button" onclick="decreaseQty()">−</button>
                    <input type="number" class="form-control text-center fw-semibold" id="Count" name="Count" value="1" min="1">
                    <button class="btn btn-outline-dark" type="button" onclick="increaseQty()">+</button>
                </div>
            </div>

            <div id="quantityDisplay" class="text-muted small mb-4">Tồn kho: Chọn màu và kích thước để xem</div>

            <!-- Divider -->
            <hr class="my-4">

            <!-- Action Buttons -->
            <div class="d-flex gap-3">
                <button type="submit" class="btn btn-dark btn-lg flex-grow-1 rounded-3 fw-semibold" name="action" value="addtocart" onclick="setSelectedOptions()">
                    Thêm Vào Giỏ
                </button>
                <button type="submit" class="btn btn-outline-dark btn-lg flex-grow-1 rounded-3 fw-semibold" name="action" value="buynow" onclick="setSelectedOptions()">
                    Mua Ngay
                </button>
            </div>

            <input type="hidden" id="ProductIdVariant" name="ProductIdVariant" value="">
        </form>
    </div>
</div>

<script src="~/js/GetColor_Size.js"></script>
<script>
    function decreaseQty() {
        const input = document.getElementById('Count');
        if (input.value > 1) input.value = parseInt(input.value) - 1;
    }

    function increaseQty() {
        const input = document.getElementById('Count');
        input.value = parseInt(input.value) + 1;
    }

    function setSelectedOptions() {
        const colorRadio = document.querySelector('input[name="color-outlined"]:checked');
        const sizeRadio = document.querySelector('input[name="size-outlined"]:checked');

        if (colorRadio) document.getElementById('selectedColorId').value = colorRadio.value;
        if (sizeRadio) document.getElementById('selectedSizeId').value = sizeRadio.value;
    }

    function updateQuantityDisplay() {
        const color = document.querySelector('input[name="color-outlined"]:checked');
        const size = document.querySelector('input[name="size-outlined"]:checked');

        if (color && size) {
            fetch(`/Sale/GetProductVariantQuantity?sizeId=${size.value}&colorId=${color.value}&productId=@Model.ID`)
                .then(r => r.json())
                .then(data => {
                    document.getElementById('quantityDisplay').textContent = `Tồn kho: ${data.quantity} sản phẩm`;
                    document.getElementById('ProductIdVariant').value = data.id;
                });
        }
    }
</script>
